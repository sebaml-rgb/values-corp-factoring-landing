{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/factoring.html",
      "destination": "/",
      "permanent": true,
      "has": [{ "type": "host", "value": "valuescorp.cl" }]
    },
    {
      "source": "/factoring",
      "destination": "/",
      "permanent": true,
      "has": [{ "type": "host", "value": "valuescorp.cl" }]
    },
    {
      "source": "/factoring.html",
      "destination": "/",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.valuescorp.cl" }]
    },
    {
      "source": "/factoring",
      "destination": "/",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.valuescorp.cl" }]
    },
    {
      "source": "/equipo",
      "destination": "/factoring-equipo",
      "permanent": false
    },
    {
      "source": "/soluciones",
      "destination": "/factoring-soluciones",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/factoring.html"
    },
    {
      "source": "/equipo",
      "destination": "/factoring-equipo.html"
    },
    {
      "source": "/factoring/equipo",
      "destination": "/factoring-equipo.html"
    },
    {
      "source": "/soluciones",
      "destination": "/factoring-soluciones.html"
    },
    {
      "source": "/factoring/soluciones",
      "destination": "/factoring-soluciones.html"
    },
    {
      "source": "/privacidad",
      "destination": "/privacidad.html"
    },
    {
      "source": "/terminos",
      "destination": "/terminos.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/api/cms/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://*.public.blob.vercel-storage.com; media-src 'self'; connect-src 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(?<sub>.*)\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
